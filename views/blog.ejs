<%- include('partials/html-start', { title: 'Blog' }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
                    <h1 class="display-5 fw-bolder mb-0">Blog</h1>

                    <!-- Search -->
                    <form class="d-flex ms-auto" method="get" action="/blog" role="search">
                        <input class="form-control me-2" type="search" name="q" placeholder="Search posts…"
                            value="<%= q || '' %>" aria-label="Search posts" />
                        <button class="btn btn-outline-secondary" type="submit">Search</button>
                    </form>

                    <% if (isAdmin) { %>
                        <a class="btn btn-warning" href="/admin/blog/new">New Post</a>
                        <% } %>
                </div>

                <p class="text-muted mb-4">
                    Notes from my learning-in-public journey.
                    <% if (q) { %>
                        <span class="ms-2">Showing <strong>
                                <%= total %>
                            </strong> result<%= total===1?'':'s' %> for “<%= q %>”.</span>
                        <% } %>
                </p>

                <% if (!posts || posts.length===0) { %>
                    <div class="alert alert-info">
                        No posts yet. Visit <code>/dev/seed</code> once to add sample posts.
                    </div>
                    <% } else { %>
                        <div class="list-group">
                            <% posts.forEach(p=> { %>
                                <div class="list-group-item">
                                    <div class="row g-3 align-items-center">
                                        <!-- thumbnail -->
                                        <div class="col-12 col-sm-4 col-md-3">
                                            <a class="d-block" href="/blog/<%= p.slug %>">
                                                <img src="<%= p.coverImage || '/img/share-default.jpg' %>"
                                                    alt="<%= p.title %>" class="img-fluid rounded"
                                                    style="aspect-ratio: 16/9; object-fit: cover;" />
                                            </a>
                                        </div>

                                        <!-- content -->
                                        <div class="col-12 col-sm-8 col-md-9">
                                            <div class="d-flex w-100 justify-content-between align-items-baseline">
                                                <h2 class="h5 mb-1">
                                                    <a class="text-decoration-none" href="/blog/<%= p.slug %>">
                                                        <%= p.title %>
                                                    </a>
                                                    <% if (isAdmin && !p.published) { %>
                                                        <span
                                                            class="badge rounded-pill text-bg-secondary ms-2">Draft</span>
                                                        <% } %>
                                                </h2>
                                                <small class="text-muted">
                                                    <%= new Date(p.createdAt).toLocaleDateString() %>
                                                </small>
                                            </div>

                                            <p class="mb-2 text-muted">
                                                <%= (p.body || "" ).slice(0, 160) %>
                                                    <%= (p.body || "" ).length> 160 ? "…" : "" %>
                                            </p>

                                            <div class="d-flex gap-2">
                                                <a class="btn btn-sm btn-outline-secondary"
                                                    href="/blog/<%= p.slug %>">Read more</a>
                                                <% if (isAdmin) { %>
                                                    <a class="btn btn-sm btn-warning"
                                                        href="/admin/blog/<%= p.slug %>/edit">Edit</a>
                                                    <form method="post" action="/admin/blog/<%= p.slug %>/delete"
                                                        class="d-inline"
                                                        onsubmit="return confirm('Delete “<%= p.title %>”?');">
                                                        <button class="btn btn-sm btn-danger"
                                                            type="submit">Delete</button>
                                                    </form>
                                                    <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                        </div>

                        <!-- Pagination -->
                        <% if (totalPages> 1) { %>
                            <nav class="mt-4" aria-label="Blog pagination">
                                <ul class="pagination justify-content-center">
                                    <li class="page-item <%= page<=1 ? 'disabled' : '' %>">
                                        <a class="page-link"
                                            href="/blog?<%= q ? 'q='+encodeURIComponent(q)+'&' : '' %>page=<%= page-1 %>"
                                            aria-label="Previous">« Prev</a>
                                    </li>

                                    <li class="page-item disabled">
                                        <span class="page-link">Page <%= page %> of <%= totalPages %></span>
                                    </li>

                                    <li class="page-item <%= page>=totalPages ? 'disabled' : '' %>">
                                        <a class="page-link"
                                            href="/blog?<%= q ? 'q='+encodeURIComponent(q)+'&' : '' %>page=<%= page+1 %>"
                                            aria-label="Next">Next »</a>
                                    </li>
                                </ul>
                            </nav>
                            <% } %>
                                <% } %>
            </div>
        </section>

        <%- include('partials/footer') %>
            <%- include('partials/html-end') %>