<%- include('partials/html-start', { title: 'Blog' }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container">
                <h1 class="mb-3">Blog</h1>
                <p class="text-muted">Notes from my learning-in-public journey.</p>

                <!-- Search + Filters -->
                <form class="row g-2 align-items-center mb-4" method="get" action="/blog" role="search">
                    <div class="col-md-6">
                        <input class="form-control" type="search" name="q" placeholder="Search posts…"
                            value="<%= q || '' %>" aria-label="Search posts" />
                    </div>
                    <div class="col-md-3">
                        <input class="form-control" type="text" name="tag" placeholder="Filter by tag…"
                            value="<%= tag || '' %>" aria-label="Tag filter">
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" name="status">
                            <option value="" <%=!status ? 'selected' : '' %>>All</option>
                            <option value="published" <%=status==='published' ? 'selected' : '' %>>Published</option>
                            <option value="draft" <%=status==='draft' ? 'selected' : '' %>>Drafts</option>
                        </select>
                    </div>
                    <div class="col-md-1 d-grid">
                        <button class="btn btn-primary" type="submit">Go</button>
                    </div>
                </form>

                <% if (posts.length===0) { %>
                    <div class="alert alert-info">No posts found.</div>
                    <% } %>

                        <% posts.forEach(p=> { %>
                            <div class="card border-0 border-start border-4 mb-4">
                                <div class="card-body">
                                    <div class="row g-3 align-items-center">
                                        <div class="col-auto">
                                            <img src="<%= p.coverImage || '/img/blog/share-default.png' %>"
                                                alt="<%= p.title %>"
                                                style="width: 180px; height: 110px; object-fit: cover;"
                                                class="rounded shadow-sm" />
                                        </div>
                                        <div class="col">
                                            <div class="d-flex align-items-center gap-2">
                                                <h5 class="mb-1"><a class="text-decoration-none"
                                                        href="/blog/<%= p.slug %>">
                                                        <%= p.title %>
                                                    </a></h5>
                                                <% if (!p.isPublished) { %>
                                                    <span class="badge bg-secondary">Draft</span>
                                                    <% } %>
                                            </div>

                                            <p class="text-muted mb-2">
                                                <%= p.excerpt %>
                                            </p>

                                            <% if (p.tags?.length) { %>
                                                <div class="small">
                                                    <% p.tags.forEach(t=> { %>
                                                        <a href="/blog?tag=<%= encodeURIComponent(t) %>"
                                                            class="badge bg-light text-dark border me-1">
                                                            <%= t %>
                                                        </a>
                                                        <% }) %>
                                                </div>
                                                <% } %>

                                                    <div class="d-flex align-items-center mt-2">
                                                        <a class="btn btn-sm btn-outline-dark me-2"
                                                            href="/blog/<%= p.slug %>">Read more</a>

                                                        <% if (isAdmin) { %>
                                                            <a class="btn btn-sm btn-warning me-2"
                                                                href="/admin/blog/<%= p.slug %>/edit">Edit</a>
                                                            <form action="/admin/blog/<%= p.slug %>/delete"
                                                                method="post" class="d-inline"
                                                                onsubmit="return confirm('Delete this post?');">
                                                                <button class="btn btn-sm btn-danger"
                                                                    type="submit">Delete</button>
                                                            </form>
                                                            <% } %>
                                                                <span class="ms-auto text-muted small">
                                                                    <%= new Date(p.createdAt).toLocaleDateString() %>
                                                                </span>
                                                    </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }) %>

                                <!-- Pagination -->
                                <% if (totalPages> 1) { %>
                                    <nav class="mt-4" aria-label="Blog pagination">
                                        <ul class="pagination justify-content-center">
                                            <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                                                <a class="page-link"
                                                    href="/blog?<%= qs({q, tag, status, page: page-1}) %>">Prev</a>
                                            </li>

                                            <% for (let i=1; i <=totalPages; i++) { %>
                                                <li class="page-item <%= i === page ? 'active' : '' %>">
                                                    <a class="page-link"
                                                        href="/blog?<%= qs({q, tag, status, page: i}) %>">
                                                        <%= i %>
                                                    </a>
                                                </li>
                                                <% } %>

                                                    <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                                                        <a class="page-link"
                                                            href="/blog?<%= qs({q, tag, status, page: page+1}) %>">Next</a>
                                                    </li>
                                        </ul>
                                    </nav>
                                    <% } %>
            </div>
        </section>

        <%- include('partials/html-end') %>