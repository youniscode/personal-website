<%- include('partials/html-start', { title: 'Blog' }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container">

                <!-- Heading + search -->
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
                    <h1 class="mb-0">Blog</h1>

                    <form class="d-flex ms-auto" method="get" action="/blog" role="search">
                        <input class="form-control me-2" type="search" name="q" placeholder="Search posts…"
                            value="<%= typeof q !== 'undefined' ? q : '' %>" aria-label="Search posts">
                        <% if (typeof tag !=='undefined' && tag) { %>
                            <input type="hidden" name="tag" value="<%= tag %>">
                            <% } %>
                                <button class="btn btn-outline-secondary" type="submit">Search</button>
                    </form>
                </div>

                <!-- Active tag filter header -->
                <% if (typeof tag !=='undefined' && tag) { %>
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis me-2">
                            Tag: <%= tag %>
                        </span>
                        <a href="/blog" class="small text-decoration-none">Clear</a>
                    </div>
                    <% } %>

                        <!-- Empty state -->
                        <% if (!posts || posts.length===0) { %>
                            <div class="alert alert-info">
                                No posts found. Try clearing filters or searching with different keywords.
                            </div>
                            <% } %>

                                <!-- List -->
                                <div class="vstack gap-4">
                                    <% (posts || []).forEach(p=> { %>
                                        <article class="card shadow-sm overflow-hidden">
                                            <div class="row g-0">

                                                <!-- Thumb (if any) -->
                                                <div class="col-md-3 d-none d-md-block">
                                                    <a href="/blog/<%= p.slug %>"
                                                        class="d-block ratio ratio-16x9 bg-body-tertiary">
                                                        <% if (p.coverImage) { %>
                                                            <img src="<%= p.coverImage %>" alt=""
                                                                class="object-fit-cover w-100 h-100">
                                                            <% } %>
                                                    </a>
                                                </div>

                                                <!-- Text -->
                                                <div class="col-md-9">
                                                    <div class="card-body">

                                                        <!-- Title + status chips -->
                                                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                                            <h2 class="h5 mb-0">
                                                                <a class="link-dark text-decoration-none"
                                                                    href="/blog/<%= p.slug %>">
                                                                    <%= p.title %>
                                                                </a>
                                                            </h2>

                                                            <% if (isAdmin && p.published===false) { %>
                                                                <span
                                                                    class="badge bg-warning-subtle text-warning-emphasis">Draft</span>
                                                                <% } %>
                                                                    <% if (p.updatedAt && p.createdAt && new
                                                                        Date(p.updatedAt) - new Date(p.createdAt)> 5 *
                                                                        60 * 1000) { %>
                                                                        <span
                                                                            class="badge bg-info-subtle text-info-emphasis">Updated</span>
                                                                        <% } %>
                                                                            <% if (typeof p.readMins !=='undefined' ) {
                                                                                %>
                                                                                <span
                                                                                    class="badge bg-light border text-muted">
                                                                                    <%= p.readMins %> min read
                                                                                </span>
                                                                                <% } %>
                                                        </div>

                                                        <!-- Meta line -->
                                                        <div class="text-muted small mb-2">
                                                            <time datetime="<%= new Date(p.createdAt).toISOString() %>">
                                                                <%= new Date(p.createdAt).toLocaleDateString() %>
                                                            </time>
                                                            <% if (p.tags && p.tags.length) { %> ·
                                                                <% p.tags.forEach((t, i)=> { %>
                                                                    <a href="/blog?tag=<%= encodeURIComponent(t) %>"
                                                                        class="text-decoration-none">#<%= t %></a>
                                                                    <%= i < p.tags.length - 1 ? ', ' : '' %>
                                                                        <% }) %>
                                                                            <% } %>
                                                        </div>

                                                        <!-- Excerpt -->
                                                        <p class="mb-3">
                                                            <%= (p.bodyHtml || '' ).replace(/<[^>]+>/g, '').slice(0,
                                                                180) %>…
                                                        </p>

                                                        <!-- Tag chips -->
                                                        <% if (p.tags && p.tags.length) { %>
                                                            <div class="mb-3 d-flex flex-wrap gap-2">
                                                                <% p.tags.forEach(t=> { %>
                                                                    <a href="/blog?tag=<%= encodeURIComponent(t) %>"
                                                                        class="badge rounded-pill bg-light border">#<%=
                                                                            t %></a>
                                                                    <% }) %>
                                                            </div>
                                                            <% } %>

                                                                <!-- Actions -->
                                                                <div class="d-flex gap-2">
                                                                    <a href="/blog/<%= p.slug %>"
                                                                        class="btn btn-sm btn-primary">Read more</a>
                                                                    <% if (isAdmin) { %>
                                                                        <a href="/admin/blog/<%= p.slug %>/edit"
                                                                            class="btn btn-sm btn-outline-secondary"
                                                                            data-admin-edit>Edit</a>
                                                                        <% } %>
                                                                </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </article>
                                        <% }) %>
                                </div>

                                <!-- Pagination -->
                                <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
                                    <nav class="mt-4" aria-label="Blog pagination">
                                        <ul class="pagination justify-content-center">
                                            <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                                                <a class="page-link"
                                                    href="?page=<%= page-1 %><%= q ? '&q='+encodeURIComponent(q) : '' %><%= tag ? '&tag='+encodeURIComponent(tag) : '' %>">Prev</a>
                                            </li>

                                            <% for (let i=1; i <=totalPages; i++) { %>
                                                <li class="page-item <%= i === page ? 'active' : '' %>">
                                                    <a class="page-link"
                                                        href="?page=<%= i %><%= q ? '&q='+encodeURIComponent(q) : '' %><%= tag ? '&tag='+encodeURIComponent(tag) : '' %>">
                                                        <%= i %>
                                                    </a>
                                                </li>
                                                <% } %>

                                                    <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                                                        <a class="page-link"
                                                            href="?page=<%= page+1 %><%= q ? '&q='+encodeURIComponent(q) : '' %><%= tag ? '&tag='+encodeURIComponent(tag) : '' %>">Next</a>
                                                    </li>
                                        </ul>
                                    </nav>
                                    <% } %>

            </div>
        </section>

        <%- include('partials/footer') %>
            <%- include('partials/html-end') %>

                <script>
                    // Tiny admin shortcut: 'e' focuses the first visible "Edit" on the page.
                    document.addEventListener('keydown', (e) => {
                        if (e.target && ['INPUT', 'TEXTAREA'].includes(e.target.tagName)) return;
                        if (e.key.toLowerCase() === 'e') {
                            const firstEdit = document.querySelector('[data-admin-edit]');
                            if (firstEdit) window.location.href = firstEdit.getAttribute('href');
                        }
                    });
                </script>