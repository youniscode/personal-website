<%- include('partials/html-start', { title: 'Blog' }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container">

                <!-- Heading + quick actions -->
                <div class="d-flex align-items-center mb-3">
                    <h1 class="display-5 fw-bolder mb-0">Blog</h1>

                    <% if (isAdmin) { %>
                        <a class="btn btn-outline-secondary btn-sm ms-3" href="/admin/blog/new">New Post</a>
                        <% } %>

                            <!-- Search -->
                            <form class="d-flex ms-auto" method="get" action="/blog" role="search">
                                <input class="form-control me-2" type="search" name="q" placeholder="Search posts…"
                                    value="<%= q || '' %>" aria-label="Search posts">
                                <% if (tag) { %><input type="hidden" name="tag" value="<%= tag %>">
                                    <% } %>
                                        <button class="btn btn-outline-secondary" type="submit">Search</button>
                            </form>
                </div>

                <p class="text-muted">
                    Notes from my learning-in-public journey.
                    <% if (q) { %><span class="badge bg-secondary ms-2">search: "<%= q %>"</span>
                        <% } %>
                            <% if (tag) { %><span class="badge bg-primary ms-2">tag: <%= tag %></span>
                                <% } %>
                </p>

                <% if (!posts || posts.length===0) { %>
                    <div class="alert alert-info">No posts found.</div>
                    <% } else { %>

                        <!-- Post list with thumbnail previews -->
                        <div class="vstack gap-3">
                            <% posts.forEach(p=> {
                                const thumb = p.coverImage || '/img/share-default.jpg';
                                %>
                                <article class="card shadow-sm border-0">
                                    <div class="row g-0 align-items-stretch">
                                        <!-- Thumbnail -->
                                        <div class="col-12 col-md-3">
                                            <a href="/blog/<%= p.slug %>" class="d-block h-100">
                                                <img src="<%= thumb %>" alt="<%= p.title %>"
                                                    class="img-fluid rounded-start"
                                                    style="width:100%; height: 160px; object-fit: cover;">
                                            </a>
                                        </div>

                                        <!-- Text -->
                                        <div class="col-12 col-md-9">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <h2 class="h5 card-title mb-1">
                                                        <a href="/blog/<%= p.slug %>" class="text-decoration-none">
                                                            <%= p.title %>
                                                        </a>
                                                        <% if (p.published===false) { %>
                                                            <span class="badge bg-warning text-dark ms-2">Draft</span>
                                                            <% } %>
                                                    </h2>
                                                    <small class="text-muted ms-3">
                                                        <%= new Date(p.createdAt).toLocaleDateString() %>
                                                    </small>
                                                </div>

                                                <% if (p.tags && p.tags.length) { %>
                                                    <div class="mb-1">
                                                        <% p.tags.forEach(t=> { %>
                                                            <a class="badge rounded-pill text-bg-light me-1"
                                                                href="/blog?tag=<%= encodeURIComponent(t) %>">
                                                                <%= t %>
                                                            </a>
                                                            <% }) %>
                                                    </div>
                                                    <% } %>

                                                        <p class="card-text text-muted mb-2">
                                                            <%= (p.body || "" ).slice(0, 150) %>
                                                                <%= (p.body || "" ).length> 150 ? "…" : "" %>
                                                        </p>

                                                        <a class="btn btn-sm btn-outline-primary"
                                                            href="/blog/<%= p.slug %>">Read more</a>
                                                        <% if (isAdmin) { %>
                                                            <a class="btn btn-sm btn-outline-secondary ms-2"
                                                                href="/admin/blog/<%= p.slug %>/edit">Edit</a>
                                                            <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </article>
                                <% }) %>
                        </div>

                        <!-- Pagination -->
                        <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
                            <nav class="mt-4" aria-label="Blog pagination">
                                <ul class="pagination justify-content-center">
                                    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                                        <a class="page-link"
                                            href="/blog?<%= new URLSearchParams({ q: q || '', tag: tag || '', page: String(page-1) }).toString() %>">Prev</a>
                                    </li>

                                    <% for (let i=1; i <=totalPages; i++) { %>
                                        <li class="page-item <%= page === i ? 'active' : '' %>">
                                            <a class="page-link"
                                                href="/blog?<%= new URLSearchParams({ q: q || '', tag: tag || '', page: String(i) }).toString() %>">
                                                <%= i %>
                                            </a>
                                        </li>
                                        <% } %>

                                            <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                                                <a class="page-link"
                                                    href="/blog?<%= new URLSearchParams({ q: q || '', tag: tag || '', page: String(page+1) }).toString() %>">Next</a>
                                            </li>
                                </ul>
                            </nav>
                            <% } %>

                                <% } %>
            </div>
        </section>

        <%- include('partials/footer') %>
            <%- include('partials/html-end') %>