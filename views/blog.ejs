<%- include('partials/html-start', { title: 'Blog' }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h1 class="display-5 fw-bolder mb-0">Blog</h1>
                    <% if (isAdmin) { %>
                        <a class="btn btn-outline-secondary btn-sm" href="/admin/blog/new">New Post</a>
                        <% } %>
                </div>

                <p class="text-muted mb-4">Notes from my learning-in-public journey.</p>

                <% if (!posts || posts.length===0) { %>
                    <div class="alert alert-info">
                        No posts yet. Visit <code>/dev/seed</code> once to add sample posts.
                    </div>
                    <% } else { %>
                        <% posts.forEach(p=> { %>
                            <div class="card border-0 shadow-sm mb-4">
                                <div class="card-body">
                                    <div class="row g-3 align-items-center">
                                        <div class="col-12 col-md-3">
                                            <a href="/blog/<%= p.slug %>">
                                                <img src="<%= p.coverImage || '/img/share-default.jpg' %>"
                                                    alt="<%= p.title %>" class="img-fluid rounded"
                                                    style="aspect-ratio: 16/9; object-fit: cover;">
                                            </a>
                                        </div>
                                        <div class="col-12 col-md-9">
                                            <div class="d-flex justify-content-between">
                                                <h2 class="h5 mb-1">
                                                    <a class="text-decoration-none" href="/blog/<%= p.slug %>">
                                                        <%= p.title %>
                                                    </a>
                                                </h2>
                                                <small class="text-muted">
                                                    <%= new Date(p.createdAt).toLocaleDateString() %>
                                                </small>
                                            </div>
                                            <p class="mb-3 text-muted">
                                                <%= (p.body || "" ).slice(0, 160) %>
                                                    <%= (p.body || "" ).length> 160 ? "…" : "" %>
                                            </p>

                                            <div class="d-flex gap-2">
                                                <a class="btn btn-sm btn-outline-secondary"
                                                    href="/blog/<%= p.slug %>">Read more</a>
                                                <% if (isAdmin) { %>
                                                    <a class="btn btn-sm btn-warning"
                                                        href="/admin/blog/<%= p.slug %>/edit">Edit</a>
                                                    <form method="post" action="/admin/blog/<%= p.slug %>/delete"
                                                        class="d-inline" data-confirm='Delete “<%= p.title %>”?'>
                                                        <button class="btn btn-sm btn-danger"
                                                            type="submit">Delete</button>
                                                    </form>
                                                    <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                                <% } %>
            </div>
        </section>

        <%- include('partials/footer') %>
            <%- include('partials/html-end') %>