<footer class="site-footer mt-5">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-md">
                <p class="mb-0">
                    © <%= new Date().getFullYear() %> <strong>
                            <%= site.name %>
                        </strong>.
                        Built with <span class="fw-bold">Node.js</span>, <span class="fw-bold">Express</span> & <span
                            class="fw-bold">EJS</span>.
                </p>
            </div>
            <div class="col-md text-md-end">
                <% if (site.email) { %>
                    <a class="footer-link me-3" href="mailto:<%= site.email %>">Email</a>
                    <% } %>
                        <% if (site.linkedin) { %>
                            <a class="footer-link" href="<%= site.linkedin %>" target="_blank"
                                rel="noopener">LinkedIn</a>
                            <% } %>
            </div>
        </div>
    </div>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Highlight.js -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => { window.hljs?.highlightAll(); });
</script>

<!-- Custom JS -->
<script src="/js/main.js"></script>