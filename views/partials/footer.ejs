<footer class="mt-5 py-5 bg-dark text-light border-top">
    <div class="container">
        <div class="row g-4 align-items-start">

            <!-- About -->
            <div class="col-md-6">
                <h5 class="mb-3">About</h5>
                <p class="mb-3 text-secondary">
                    I’m <strong>
                        <%= site.name %>
                    </strong>, a <%= site.role || 'developer' %> based in
                        <%= site.location || '—' %>. I build modern, fast, accessible web apps and share my work in
                            public.
                </p>

                <!-- Contact line (email + phone if present) -->
                <ul class="list-unstyled small mb-0">
                    <% if (site.email) { %>
                        <li class="mb-1">
                            📧 <a class="footer-link" href="mailto:<%= site.email %>">
                                <%= site.email %>
                            </a>
                        </li>
                        <% } %>
                            <% if (site.phone) { %>
                                <li class="mb-1">
                                    📱 <span class="text-secondary">
                                        <%= site.phone %>
                                    </span>
                                </li>
                                <% } %>
                                    <% if (site.linkedin) { %>
                                        <li class="mb-1">
                                            💼 <a class="footer-link" href="<%= site.linkedin %>" target="_blank"
                                                rel="noopener">LinkedIn</a>
                                        </li>
                                        <% } %>
                                            <% /* Optional future handles — only render if you add them to
                                                app.locals.site */ %>
                                                <% if (site.github) { %>
                                                    <li class="mb-1">
                                                        🧑‍💻 <a class="footer-link" href="<%= site.github %>"
                                                            target="_blank" rel="noopener">GitHub</a>
                                                    </li>
                                                    <% } %>
                                                        <% if (site.twitter) { %>
                                                            <li class="mb-1">
                                                                🐦 <a class="footer-link" href="<%= site.twitter %>"
                                                                    target="_blank" rel="noopener">Twitter</a>
                                                            </li>
                                                            <% } %>
                </ul>
            </div>

            <!-- Quick Links -->
            <div class="col-6 col-md-3">
                <h5 class="mb-3">Quick links</h5>
                <ul class="list-unstyled">
                    <li class="mb-2"><a class="footer-link" href="/">Home</a></li>
                    <li class="mb-2"><a class="footer-link" href="/projects">Projects</a></li>
                    <li class="mb-2"><a class="footer-link" href="/about">About</a></li>
                    <li class="mb-2"><a class="footer-link" href="/blog">Blog</a></li>
                    <li class="mb-2"><a class="footer-link" href="/contact">Contact</a></li>
                    <% if (site.cvUrl) { %>
                        <li class="mb-2"><a class="footer-link" href="<%= site.cvUrl %>" target="_blank"
                                rel="noopener">Download CV</a></li>
                        <% } %>
                </ul>
            </div>

            <!-- Subscribe / RSS -->
            <div class="col-6 col-md-3">
                <h5 class="mb-3">Stay in the loop</h5>
                <ul class="list-unstyled mb-3">
                    <li class="mb-2">
                        <a class="footer-link" href="/rss.xml" target="_blank" rel="noopener">RSS feed</a>
                    </li>
                    <li class="mb-2">
                        <a class="footer-link" href="/sitemap.xml" target="_blank" rel="noopener">Sitemap</a>
                    </li>
                </ul>

                <!-- Back to top -->
                <a href="#" class="btn btn-outline-light btn-sm">Back to top ↑</a>
            </div>
        </div>

        <hr class="border-secondary my-4">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start small text-secondary">
            <div>
                © <%= new Date().getFullYear() %>
                    <%= site.name %>. All rights reserved.
            </div>
            <div class="mt-2 mt-md-0">
                <span class="me-2">Built with Node.js, Express, EJS & MongoDB.</span>
                <a class="footer-link" href="/health">Status</a>
            </div>
        </div>
    </div>
</footer>