<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>
        <%= (meta && meta.title) || (site && site.name) %>
    </title>
    <meta name="description" content="<%= (meta && meta.description) || (site && site.role) || '' %>" />
    <meta name="robots" content="<%= (meta && meta.robots) || 'index,follow' %>" />

    <% if (meta && meta.canonical) { %>
        <link rel="canonical" href="<%= meta.canonical %>">
        <% } %>

            <!-- Open Graph -->
            <meta property="og:type" content="<%= (meta && meta.type) || 'website' %>">
            <% if (meta && meta.title) { %>
                <meta property="og:title" content="<%= meta.title %>">
                <% } %>
                    <% if (meta && meta.description) { %>
                        <meta property="og:description" content="<%= meta.description %>">
                        <% } %>
                            <% if (meta && meta.url) { %>
                                <meta property="og:url" content="<%= meta.url %>">
                                <% } %>
                                    <% if (meta && meta.image) { %>
                                        <meta property="og:image" content="<%= meta.image %>">
                                        <% } %>
                                            <% if (site && site.name) { %>
                                                <meta property="og:site_name" content="<%= site.name %>">
                                                <% } %>

                                                    <!-- Twitter -->
                                                    <meta name="twitter:card" content="summary_large_image">
                                                    <% if (meta && meta.title) { %>
                                                        <meta name="twitter:title" content="<%= meta.title %>">
                                                        <% } %>
                                                            <% if (meta && meta.description) { %>
                                                                <meta name="twitter:description"
                                                                    content="<%= meta.description %>">
                                                                <% } %>
                                                                    <% if (meta && meta.image) { %>
                                                                        <meta name="twitter:image"
                                                                            content="<%= meta.image %>">
                                                                        <% } %>

                                                                            <!-- Feeds -->
                                                                            <link rel="alternate"
                                                                                type="application/rss+xml" title="RSS"
                                                                                href="/rss.xml" />
                                                                            <link rel="sitemap" type="application/xml"
                                                                                title="Sitemap" href="/sitemap.xml" />

                                                                            <!-- Favicons -->
                                                                            <link rel="icon"
                                                                                href="/img/site-logo.png" />
                                                                            <link rel="apple-touch-icon"
                                                                                href="/img/site-logo.png" />

                                                                            <!-- Perf hints -->
                                                                            <link rel="preconnect"
                                                                                href="https://cdn.jsdelivr.net">
                                                                            <link rel="dns-prefetch"
                                                                                href="//cdn.jsdelivr.net">

                                                                            <!-- Bootstrap CSS -->
                                                                            <link
                                                                                href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
                                                                                rel="stylesheet"
                                                                                integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
                                                                                crossorigin="anonymous" />

                                                                            <!-- Your styles -->
                                                                            <link rel="stylesheet"
                                                                                href="/css/styles.css" />

                                                                            <!-- JSON-LD (supports res.locals.ld or res.locals.jsonLd) -->
                                                                            <% const _ld=(typeof ld !=='undefined' &&
                                                                                ld) ? ld : ((typeof jsonLd
                                                                                !=='undefined' && jsonLd) ? jsonLd :
                                                                                null); %>
                                                                                <% if (_ld) { %>
                                                                                    <script
                                                                                        type="application/ld+json"><%- JSON.stringify(_ld, null, 2) %></script>
                                                                                    <% } %>
</head>

<body>