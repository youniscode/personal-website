<%- include('partials/html-start', { title: 'Projects' }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container">
                <header class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h1 class="display-6 fw-bolder mb-1">Projects</h1>
                        <p class="text-muted mb-0">Selected work-in-progress and shipped projects.</p>
                    </div>
                    <a class="btn btn-outline-secondary btn-sm" href="/contact">Get in touch</a>
                </header>

                <div class="row g-4">

                    <!-- Project 1: Flight Briefing & Route Kit -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <article class="card h-100 shadow-sm rise overflow-hidden">
                            <a href="/projects/flight-briefing" class="ratio ratio-16x9 bg-body-tertiary d-block">
                                <!-- Put your 1280x720-ish image at /public/img/projects/flight-briefing-thumb.png -->
                                <img src="/img/projects/flight-briefing-thumb.png"
                                    alt="Flight Briefing & Route Kit preview" class="w-100 h-100 object-fit-cover"
                                    loading="lazy">
                            </a>
                            <div class="card-body d-flex flex-column">
                                <h2 class="h5 fw-bold mb-1">
                                    <a class="stretched-link text-decoration-none link-dark"
                                        href="/projects/flight-briefing">
                                        Flight Briefing &amp; Route Kit
                                    </a>
                                </h2>
                                <p class="text-muted small mb-3">
                                    Plan routes, summarize METAR/TAF &amp; NOTAMs, and export a printable route kit.
                                </p>

                                <!-- Tech chips -->
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <span class="badge bg-light border text-muted">Node.js</span>
                                    <span class="badge bg-light border text-muted">Express</span>
                                    <span class="badge bg-light border text-muted">EJS</span>
                                    <span class="badge bg-light border text-muted">Bootstrap</span>
                                </div>

                                <!-- Status / CTAs -->
                                <div class="mt-auto d-flex gap-2 align-items-center">
                                    <span class="badge bg-success-subtle text-success-emphasis">In progress</span>
                                    <!-- Replace these hrefs when ready -->
                                    <a class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true"
                                        title="Coming soon">Live demo</a>
                                    <a class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true"
                                        title="Coming soon">Source</a>
                                </div>
                            </div>
                        </article>
                    </div>

                    <!-- Project 2: Coming soon -->
