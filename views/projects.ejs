<%- include('partials/html-start', { title: 'Projects' }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container">
                <h1 class="display-6 fw-bolder mb-3">Projects</h1>
                <p class="text-muted mb-5">A selection of projects I’m working on — more coming soon.</p>

                <!-- Project Grid -->
                <div class="row g-4">

                    <!-- Flight Briefing & Route Kit -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <article class="card h-100 shadow-sm">
                            <!-- Use whatever screenshot you have; object-fit keeps it tidy -->
                            <img class="card-img-top project-thumb" src="/img/projects/flight-briefing-thumb.png"
                                alt="Screenshot of Flight Briefing & Route Kit" loading="lazy" />
                            <div class="card-body d-flex flex-column">
                                <h2 class="h5 fw-bold mb-2">Flight Briefing &amp; Route Kit</h2>
                                <p class="text-muted mb-3">
                                    Plan routes, summarize METAR/TAF &amp; NOTAMs, and export a printable route kit.
                                </p>

                                <!-- Actions -->
                                <div class="d-flex flex-wrap gap-2 mt-auto">
                                    <!-- If you have a live URL, keep this; otherwise remove it -->
                                    <a class="btn btn-primary btn-sm"
                                        href="https://github.com/youniscode/flight-briefing-kit" target="_blank"
                                        rel="noopener">Source Code</a>

                                    <!--<a class="btn btn-outline-secondary btn-sm"
                                        href="https://github.com/youniscode/flight-briefing-kit" target="_blank"
                                        rel="noopener">Source</a> -->

                                    <a class="btn btn-outline-dark btn-sm" href="/projects/flight-briefing">Details</a>
                                </div>

                                <!-- Status chips -->
                                <div class="mt-3 d-flex flex-wrap gap-2">
                                    <span class="badge bg-success-subtle text-success-emphasis">In progress</span>
                                    <span class="badge bg-info-subtle text-info-emphasis">Prototype</span>
                                </div>
                            </div>
                        </article>
                    </div>

                    <!-- Project placeholder -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <article class="card h-100 shadow-sm">
                            <img class="card-img-top project-thumb" src="/img/site-logo.png" alt="Project placeholder"
                                loading="lazy" />
                            <div class="card-body d-flex flex-column">
                                <h2 class="h5 fw-bold mb-2">Project Two (Coming soon)</h2>
                                <p class="text-muted mb-3">Another project will be added here soon.</p>
                                <div class="mt-auto">
                                    <span class="badge bg-secondary">Coming soon</span>
                                </div>
                            </div>
                        </article>
                    </div>

                    <!-- Project placeholder -->
                    <div class="col-12 col-md-6 col-lg-4">
                        <article class="card h-100 shadow-sm">
                            <img class="card-img-top project-thumb" src="/img/site-logo.png" alt="Project placeholder"
                                loading="lazy" />
                            <div class="card-body d-flex flex-column">
                                <h2 class="h5 fw-bold mb-2">Project Three (Coming soon)</h2>
                                <p class="text-muted mb-3">Stay tuned for updates.</p>
                                <div class="mt-auto">
                                    <span class="badge bg-secondary">Coming soon</span>
                                </div>
                            </div>
                        </article>
                    </div>

                </div>
            </div>
        </section>

        <%- include('partials/footer') %>
            <%- include('partials/html-end') %>