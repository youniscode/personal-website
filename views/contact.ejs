<%- include('partials/html-start', { title: 'Contact' }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container">
                <h1 class="mb-3">Contact</h1>
                <p class="text-muted mb-4">Send me a note — I’ll get back to you soon.</p>

                <!-- Alerts (success / error) -->
                <% if (sent) { %>
                    <div class="alert alert-success">✅ Thank you! Your message has been sent.</div>
                    <% } else if (err) { %>
                        <div class="alert alert-danger">
                            <%= err %>
                        </div>
                        <% } %>

                            <form action="/contact" method="post" class="mt-3" novalidate>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Your name</label>
                                        <input type="text" class="form-control" name="name"
                                            value="<%= (form && form.name) || '' %>">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Your email *</label>
                                        <input type="email" class="form-control" name="email" required
                                            value="<%= (form && form.email) || '' %>">
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Message *</label>
                                        <textarea class="form-control" name="message" rows="6"
                                            required><%= (form && form.message) || '' %></textarea>
                                    </div>
                                </div>

                                <button class="btn btn-dark mt-3" type="submit">Send message</button>
                            </form>
            </div>
        </section>

        <%- include('partials/footer') %>
            <%- include('partials/html-end') %>