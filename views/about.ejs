<%- include('partials/html-start', { title: 'About' }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container" style="max-width: 900px;">
                <h1 class="display-6 fw-bolder mb-3">About me</h1>

                <p class="lead">
                    Hi, I’m <strong>
                        <%= site.name %>
                    </strong>, based in <%= site.location %>. I build modern web apps and care about clean UX, pragmatic
                        product thinking, and shipping.
                </p>
                <p>
                    I’m trilingual (FR/EN/AR). This site is my home on the web—where I write, share progress, and
                    collect projects.
                </p>

                <hr class="my-4" />

                <h2 class="h5 text-uppercase text-muted mb-3">Recent posts</h2>

                <!-- Empty state -->
                <% if (!(posts && posts.length)) { %>
                    <div class="alert alert-info">No posts yet. Head over to the <a href="/blog">blog</a>.</div>
                    <% } %>

                        <div class="vstack gap-3">
                            <% (posts || []).forEach(function(p) { %>
                                <article class="card shadow-sm">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <h3 class="h5 mb-0">
                                                <a class="link-dark text-decoration-none" href="/blog/<%= p.slug %>">
                                                    <%= p.title %>
                                                </a>
                                            </h3>
                                            <% if (p.published===false) { %>
                                                <span class="badge bg-warning-subtle text-warning-emphasis">Draft</span>
                                                <% } %>
                                        </div>

                                        <div class="text-muted small mb-2">
                                            <time datetime="<%= new Date(p.createdAt).toISOString() %>">
                                                <%= new Date(p.createdAt).toLocaleDateString() %>
                                            </time>
                                            · <%= p.readingMinutes || 1 %> min read
                                        </div>

                                        <p class="mb-0">
                                            <%= (p.bodyHtml || '' ).replace(/<[^>]+>/g, '').slice(0, 160) %>…
                                        </p>
                                    </div>
                                </article>
                                <% }) %>
                        </div>

                        <div class="mt-3">
                            <a class="btn btn-outline-secondary" href="/blog">See all posts</a>
                        </div>
            </div>
        </section>

        <%- include('partials/footer') %>
            <%- include('partials/html-end') %>