<%- include('partials/html-start', { title: 'New Post' }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container">
                <h1 class="mb-4">New Post</h1>

                <form method="post" action="/admin/blog/new">
                    <div class="mb-3">
                        <label class="form-label">Title *</label>
                        <input type="text" name="title" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Slug *</label>
                        <input type="text" name="slug" class="form-control" placeholder="my-post-slug" required>
                        <div class="form-text">Used in the URL: /blog/&lt;slug&gt;</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Cover image URL</label>
                        <input type="url" name="coverImage" class="form-control" placeholder="https://...">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tags (comma-separated)</label>
                        <input type="text" name="tags" class="form-control" placeholder="node, express, ejs">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Body (Markdown supported)</label>
                        <textarea name="body" class="form-control" rows="12" required></textarea>
                    </div>

                    <!-- NEW: Published toggle -->
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" role="switch" id="publishedSwitch"
                            name="published" checked>
                        <label class="form-check-label" for="publishedSwitch">Published</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Create Post</button>
                        <a class="btn btn-outline-secondary" href="/blog">Cancel</a>
                    </div>
                </form>
            </div>
        </section>

        <%- include('partials/html-end') %>