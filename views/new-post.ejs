<%- include('partials/html-start', { title }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container" style="max-width: 820px;">
                <h1 class="display-6 fw-bolder mb-4">New Post</h1>

                <form method="post" action="/admin/blog" class="card shadow-sm p-4">
                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input name="title" type="text" class="form-control" placeholder="Post title..." required>
                        <div class="form-text">Slug will be generated from the title.</div>
                    </div>

                    <!-- ✅ Cover Image URL (optional) -->
                    <div class="mb-3">
                        <label class="form-label">Cover Image URL (optional)</label>
                        <input name="coverImage" type="url" class="form-control"
                            placeholder="https://example.com/cover.jpg or /img/my-cover.jpg">
                        <div class="form-text">Absolute URL or a public path from your site (e.g. /img/cover.jpg).</div>
                        <div id="coverPreview" class="mt-3 d-none">
                            <img id="coverPreviewImg" alt="Cover preview" class="img-fluid rounded" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Body</label>
                        <textarea id="postBody" name="body" rows="12" class="form-control"
                            placeholder="Write your post in Markdown..." required></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" type="submit">Publish</button>
                        <a class="btn btn-outline-secondary" href="/blog">Cancel</a>
                    </div>
                </form>
            </div>
        </section>

        <%- include('partials/footer') %>

            <!-- SimpleMDE (Markdown editor) -->
            <link rel="stylesheet" href="https://unpkg.com/simplemde@1.11.2/dist/simplemde.min.css">
            <script src="https://unpkg.com/simplemde@1.11.2/dist/simplemde.min.js"></script>
            <script>
                // Attach editor and ensure the underlying <textarea> is synced on submit
                const mde = new SimpleMDE({
                    element: document.getElementById('postBody'),
                    spellChecker: false,
                    status: false,
                    renderingConfig: { singleLineBreaks: false },
                    forceSync: true // ensures req.body.body has the content
                });

                // Live cover image preview
                const coverInput = document.querySelector('input[name="coverImage"]');
                const previewWrap = document.getElementById('coverPreview');
                const previewImg = document.getElementById('coverPreviewImg');

                coverInput.addEventListener('input', () => {
                    const url = coverInput.value.trim();
                    if (!url) { previewWrap.classList.add('d-none'); return; }
                    previewImg.src = url;
                    previewWrap.classList.remove('d-none');
                });
            </script>

            <%- include('partials/html-end') %>