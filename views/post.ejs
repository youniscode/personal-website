<%- include('partials/html-start', { title }) %>
    <%- include('partials/header') %>

        <section class="section blog-post">
            <div class="container" style="max-width: 860px;">
                <% if (post.coverImage) { %>
                    <div class="mb-4">
                        <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="img-fluid rounded"
                            style="width:100%; aspect-ratio: 16/9; object-fit:cover;">
                    </div>
                    <% } %>

                        <div class="d-flex align-items-center gap-2">
                            <h1 class="display-6 fw-bolder mb-0">
                                <%= post.title %>
                            </h1>
                            <% if (post.draft) { %>
                                <span class="badge bg-warning text-dark">Draft</span>
                                <% } %>
                        </div>

                        <div class="text-muted mb-4">
                            <%= new Date(post.createdAt).toLocaleDateString() %>
                        </div>

                        <div class="post-body"><%- html %></div>

                        <div class="mt-4 p-3 post-actions d-flex gap-2 align-items-center">
                            <a class="btn btn-outline-secondary btn-sm" href="/blog">← Back to blog</a>
                            <% if (isAdmin) { %>
                                <a class="btn btn-edit btn-sm" href="/admin/blog/<%= post.slug %>/edit">Edit</a>

                                <% if (post.draft) { %>
                                    <form method="post" action="/admin/blog/<%= post.slug %>/publish" class="d-inline">
                                        <button class="btn btn-success btn-sm" type="submit">Publish</button>
                                    </form>
                                    <% } else { %>
                                        <form method="post" action="/admin/blog/<%= post.slug %>/unpublish"
                                            class="d-inline">
                                            <button class="btn btn-outline-warning btn-sm"
                                                type="submit">Unpublish</button>
                                        </form>
                                        <% } %>

                                            <form method="post" action="/admin/blog/<%= post.slug %>/delete"
                                                class="d-inline" data-confirm='Delete “<%= post.title %>”?'>
                                                <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                                            </form>
                                            <% } %>
                        </div>
            </div>
        </section>

        <%- include('partials/footer') %>
            <%- include('partials/html-end') %>