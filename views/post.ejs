<%- include('partials/html-start', { title }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container blog-post" style="max-width: 860px;">
                <% if (post.coverImage) { %>
                    <img class="img-fluid rounded mb-4" src="<%= post.coverImage %>" alt="<%= post.title %>">
                    <% } %>

                        <header class="mb-3 d-flex align-items-center justify-content-between">
                            <div>
                                <h1 class="mb-1">
                                    <%= post.title %>
                                </h1>
                                <div class="text-muted">
                                    <%= new Date(post.createdAt).toLocaleDateString() %>
                                </div>
                            </div>

                            <% if (isAdmin) { %>
                                <div class="post-actions d-inline-flex gap-2">
                                    <a class="btn btn-sm btn-edit" href="/admin/blog/<%= post.slug %>/edit">Edit</a>
                                    <form method="post" action="/admin/blog/<%= post.slug %>/delete"
                                        onsubmit="return confirm('Delete “<%= post.title %>”?');" class="d-inline">
                                        <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                                    </form>
                                </div>
                                <% } %>
                        </header>

                        <% if (post.tags && post.tags.length) { %>
                            <div class="mb-3">
                                <% post.tags.forEach(t=> { %>
                                    <a class="badge rounded-pill text-bg-light me-1"
                                        href="/blog?tag=<%= encodeURIComponent(t) %>">
                                        <%= t %>
                                    </a>
                                    <% }) %>
                                        <% if (post.published===false) { %>
                                            <span class="badge bg-warning text-dark ms-2">Draft</span>
                                            <% } %>
                            </div>
                            <% } %>

                                <div class="post-body lh-lg">
                                    <!-- Sanitized HTML from Markdown -->
                                    <%- html %>
                                </div>
            </div>
        </section>

        <%- include('partials/footer') %>
            <%- include('partials/html-end') %>