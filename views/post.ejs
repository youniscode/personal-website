<%- include('partials/html-start', { title }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container blog-post" style="max-width: 860px;">
                <h1 class="display-6 fw-bolder mb-1">
                    <%= post.title %>
                </h1>
                <p class="text-muted">
                    <%= new Date(post.createdAt).toLocaleDateString() %>
                </p>

                <% if (post.coverImage) { %>
                    <img class="img-fluid rounded mb-4" src="<%= post.coverImage %>" alt="<%= post.title %>">
                    <% } %>

                        <div class="post-body lh-lg">
                            <!-- Sanitized HTML produced from Markdown -->
                            <%- html %>
                        </div>

                        <div class="mt-4 post-actions d-flex gap-2">
                            <a class="btn btn-outline-secondary" href="/blog">← Back to Blog</a>

                            <% if (isAdmin) { %>
                                <a class="btn btn-edit" href="/admin/blog/<%= post.slug %>/edit">Edit</a>
                                <form method="post" action="/admin/blog/<%= post.slug %>/delete"
                                    onsubmit="return confirm('Delete “<%= post.title %>”?');" class="d-inline">
                                    <button class="btn btn-danger" type="submit">Delete</button>
                                </form>
                                <% } %>
                        </div>
            </div>
        </section>

        <%- include('partials/footer') %>
            <%- include('partials/html-end') %>