<%- include('partials/html-start', { title }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container" style="max-width: 820px;">
                <article class="blog-post card shadow-sm p-4">
                    <header class="mb-3">
                        <h1 class="display-6 fw-bolder mb-2">
                            <%= post.title %>
                        </h1>
                        <div class="text-muted small">
                            <time datetime="<%= new Date(post.createdAt).toISOString() %>">
                                <%= new Date(post.createdAt).toLocaleDateString() %>
                            </time>
                        </div>
                    </header>

                    <div class="post-body lh-lg">
                        <!-- Admin-authored content: render with basic line breaks -->
                        <%- (post.body || "" ).replace(/\r?\n\r?\n/g, '</p><p>' ) .replace(/\r?\n/g, '<br>' ) ?
                            `<p>${(post.body || "")
                            .replace(/\r?\n\r?\n/g, '</p>
                            <p>')
                                .replace(/\r?\n/g, '<br>')}</p>` : '' %>
                    </div>

                    <footer class="mt-4 d-flex gap-2">
                        <a class="btn btn-outline-secondary" href="/blog">← Back to Blog</a>
                    </footer>
                </article>
            </div>
        </section>

        <%- include('partials/footer') %>
            <%- include('partials/html-end') %>