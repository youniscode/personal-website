<%- include('partials/html-start', { title }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container">
                <article class="card shadow-sm rise">
                    <div class="card-body p-4">
                        <h1 class="h2 mb-2">
                            <%= post.title %>
                        </h1>
                        <p class="text-muted mb-4">
                            <%= new Date(post.createdAt).toLocaleString() %>
                        </p>
                        <div class="article-body">
                            <%- (post.body || "" ).replace(/\n/g, "<br/>" ) %>
                        </div>
                        <a class="btn btn-link mt-3" href="/blog">← Back to Blog</a>
                    </div>
                </article>
            </div>
        </section>

        <%- include('partials/footer') %>
            <%- include('partials/html-end') %>