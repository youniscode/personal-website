<%- include('partials/html-start', { title }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container" style="max-width: 820px;">
                <article class="blog-post card shadow-sm p-4">
                    <header class="mb-3">
                        <h1 class="display-6 fw-bolder mb-2">
                            <%= post.title %>
                        </h1>
                        <div class="text-muted small">
                            <time datetime="<%= new Date(post.createdAt).toISOString() %>">
                                <%= new Date(post.createdAt).toLocaleDateString() %>
                            </time>
                        </div>
                    </header>
                    <% if (post.coverImage) { %>
                        <div class="mb-3">
                            <img src="<%= post.coverImage %>" alt="<%= post.title %> cover" class="img-fluid rounded">
                        </div>
                        <% } %>


                            <div class="post-body lh-lg">
                                <!-- Sanitized HTML produced from Markdown -->
                                <%- html %>
                            </div>

                            <footer class="mt-4">
                                <div class="post-actions d-flex gap-2 flex-wrap">
                                    <a class="btn btn-outline-secondary" href="/blog">← Back to Blog</a>
                                    <a class="btn btn-edit" href="/admin/blog/<%= post.slug %>/edit">Edit</a>
                                    <form method="post" action="/admin/blog/<%= post.slug %>/delete"
                                        onsubmit="return confirm('Delete this post?');" class="d-inline">
                                        <button class="btn btn-danger" type="submit">Delete</button>
                                    </form>
                                </div>
                            </footer>


                </article>
            </div>
        </section>

        <%- include('partials/footer') %>
            <%- include('partials/html-end') %>