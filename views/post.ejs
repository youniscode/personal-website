<%- include('partials/html-start', { title: post.title, description: (post.bodyHtml || post.body || ''
    ).replace(/<[^>]+>/g,'').slice(0,160) }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container">

                <!-- Top nav -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <a href="/blog" class="text-decoration-none">&larr; Back to Blog</a>

                    <% if (isAdmin) { %>
                        <div class="d-flex gap-2">
                            <a class="btn btn-sm btn-outline-secondary"
                                href="/admin/blog/<%= post.slug %>/edit">Edit</a>
                            <form method="post" action="/admin/blog/<%= post.slug %>/delete"
                                onsubmit="return confirm('Delete this post?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                        <% } %>
                </div>

                <!-- Title + meta -->
                <header class="mb-3">
                    <h1 class="mb-2">
                        <%= post.title %>
                    </h1>
                    <div class="d-flex flex-wrap align-items-center gap-2 text-muted small">
                        <time datetime="<%= new Date(post.createdAt).toISOString() %>">
                            <%= new Date(post.createdAt).toLocaleDateString() %>
                        </time>

                        <% if (isAdmin && post.published===false) { %>
                            <span class="badge bg-warning-subtle text-warning-emphasis">Draft</span>
                            <% } %>

                                <% if (Array.isArray(post.tags) && post.tags.length) { %>
                                    <span>·</span>
                                    <div class="d-flex flex-wrap gap-2">
                                        <% post.tags.forEach(t=> { %>
                                            <a class="badge rounded-pill text-bg-light text-decoration-none"
                                                href="/blog?tag=<%= encodeURIComponent(t) %>">#<%= t %></a>
                                            <% }) %>
                                    </div>
                                    <% } %>
                    </div>
                </header>

                <!-- Cover -->
                <% if (post.coverImage) { %>
                    <figure class="mb-4">
                        <img src="<%= post.coverImage %>" class="img-fluid rounded border" alt="">
                    </figure>
                    <% } %>

                        <!-- Body -->
                        <article class="prose">
                            <%- html %>
                        </article>

                        <!-- Share -->
                        <div class="border-top pt-3 mt-4">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="text-muted me-1">Share:</span>

                                <a class="btn btn-sm btn-outline-secondary"
                                    href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(shareUrl) %>&text=<%= encodeURIComponent(post.title) %>"
                                    target="_blank" rel="noopener">X / Twitter</a>

                                <a class="btn btn-sm btn-outline-secondary"
                                    href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(shareUrl) %>"
                                    target="_blank" rel="noopener">LinkedIn</a>

                                <a class="btn btn-sm btn-outline-secondary"
                                    href="https://www.reddit.com/submit?url=<%= encodeURIComponent(shareUrl) %>&title=<%= encodeURIComponent(post.title) %>"
                                    target="_blank" rel="noopener">Reddit</a>

                                <a class="btn btn-sm btn-outline-secondary"
                                    href="mailto:?subject=<%= encodeURIComponent(post.title) %>&body=<%= encodeURIComponent(shareUrl) %>">Email</a>

                                <button class="btn btn-sm btn-outline-secondary" id="copyLinkBtn" type="button"
                                    data-url="<%= shareUrl %>">Copy link</button>
                                <span class="small text-success d-none" id="copyDone">Copied!</span>
                            </div>
                        </div>

                        <!-- Prev / Next (only if provided by the route) -->
                        <% if ((typeof prevSlug !=='undefined' && prevSlug) || (typeof nextSlug !=='undefined' &&
                            nextSlug)) { %>
                            <nav class="border-top pt-3 mt-4 d-flex justify-content-between">
                                <div>
                                    <% if (prevSlug) { %>
                                        <a class="text-decoration-none" href="/blog/<%= prevSlug %>">&larr; Previous</a>
                                        <% } %>
                                </div>
                                <div>
                                    <% if (nextSlug) { %>
                                        <a class="text-decoration-none" href="/blog/<%= nextSlug %>">Next &rarr;</a>
                                        <% } %>
                                </div>
                            </nav>
                            <% } %>

            </div>
        </section>

        <%- include('partials/html-end') %>

            <script>
                (function () {
                    const btn = document.getElementById('copyLinkBtn');
                    const ok = document.getElementById('copyDone');
                    if (!btn) return;
                    btn.addEventListener('click', async () => {
                        const url = btn.getAttribute('data-url') || window.location.href;
                        try {
                            await navigator.clipboard.writeText(url);
                            ok?.classList.remove('d-none');
                            setTimeout(() => ok?.classList.add('d-none'), 1500);
                        } catch (e) {
                            alert('Copy failed. You can copy from the address bar.');
                        }
                    });

                    // Admin shortcuts: 'e' to edit, 'Backspace' to delete (with confirm)
                    document.addEventListener('keydown', (e) => {
                        if (e.target && ['INPUT', 'TEXTAREA'].includes(e.target.tagName)) return;
                        if (e.key.toLowerCase() === 'e') {
                            const edit = document.querySelector('a[href*="/edit"]');
                            if (edit) window.location.href = edit.href;
                        }
                        if (e.key === 'Backspace') {
                            const form = document.querySelector('form[action*="/delete"]');
                            if (form && confirm('Delete this post?')) form.submit();
                        }
                    });
                })();
            </script>