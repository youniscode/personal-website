<%- include('partials/html-start', { title: title }) %>
    <%- include('partials/header') %>

        <article class="section blog-post">
            <div class="container" style="max-width: 820px;">

                <!-- Title + meta -->
                <header class="mb-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <h1 class="display-6 fw-bolder mb-0">
                            <%= post.title %>
                        </h1>
                        <% if (isAdmin && post.published===false) { %>
                            <span class="badge rounded-pill text-bg-secondary">Draft</span>
                            <% } %>
                    </div>
                    <p class="text-muted mb-0">
                        <time datetime="<%= new Date(post.createdAt).toISOString() %>">
                            <%= new Date(post.createdAt).toLocaleDateString() %>
                        </time>
                        <% if (post.updatedAt && post.updatedAt.toString() !==post.createdAt.toString()) { %>
                            · <small>Updated <%= new Date(post.updatedAt).toLocaleDateString() %></small>
                            <% } %>
                    </p>
                </header>

                <!-- Cover image -->
                <% if (post.coverImage) { %>
                    <figure class="post-cover mb-4">
                        <img src="<%= post.coverImage %>" alt="<%= post.title %>"
                            class="img-fluid rounded shadow-sm w-100" style="aspect-ratio: 16/9; object-fit: cover;" />
                    </figure>
                    <% } %>

                        <!-- Body -->
                        <div class="post-body lh-lg fs-5">
                            <!-- Sanitized HTML produced from Markdown -->
                            <%- html %>
                        </div>

                        <!-- Admin actions -->
                        <% if (isAdmin) { %>
                            <footer class="mt-4 post-actions d-flex gap-2 align-items-center">
                                <a class="btn btn-edit btn-sm" href="/admin/blog/<%= post.slug %>/edit">Edit</a>
                                <form method="post" action="/admin/blog/<%= post.slug %>/delete"
                                    onsubmit="return confirm('Delete “<%= post.title %>”?');" class="d-inline">
                                    <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                                </form>
                                <span class="ms-auto text-muted small">
                                    <%= post.published ? 'Published' : 'Draft (private)' %>
                                </span>
                            </footer>
                            <% } %>

                                <!-- Back -->
                                <div class="mt-4">
                                    <a href="/blog" class="btn btn-outline-secondary btn-sm">← Back to Blog</a>
                                </div>
            </div>
        </article>

        <%- include('partials/footer') %>
            <%- include('partials/html-end') %>