<%- include('partials/html-start', { title: `Edit: ${post.title}` }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h1 class="mb-0">Edit Post</h1>

                    <!-- Quick status badge & toggle button -->
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge <%= post.published ? 'text-bg-success' : 'text-bg-secondary' %>">
                            <%= post.published ? 'Published' : 'Draft' %>
                        </span>

                        <form method="post" action="/admin/blog/<%= post.slug %>/toggle" class="d-inline">
                            <button type="submit"
                                class="btn btn-sm <%= post.published ? 'btn-outline-secondary' : 'btn-outline-success' %>">
                                <%= post.published ? 'Unpublish' : 'Publish' %>
                            </button>
                        </form>
                    </div>
                </div>

                <form method="post" action="/admin/blog/<%= post.slug %>/edit">
                    <div class="mb-3">
                        <label class="form-label">Title *</label>
                        <input type="text" name="title" class="form-control" required value="<%= post.title %>">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Slug *</label>
                        <input type="text" name="slug" class="form-control" required value="<%= post.slug %>">
                        <div class="form-text">Changing the slug changes the URL.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Cover image URL</label>
                        <input type="url" name="coverImage" class="form-control" value="<%= post.coverImage || '' %>">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tags (comma-separated)</label>
                        <input type="text" name="tags" class="form-control" value="<%= (post.tags || []).join(', ') %>">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Body (Markdown supported)</label>
                        <textarea name="body" class="form-control" rows="12" required><%= post.body %></textarea>
                    </div>

                    <!-- NEW: Published toggle -->
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" role="switch" id="publishedSwitch"
                            name="published" <%=post.published ? 'checked' : '' %>>
                        <label class="form-check-label" for="publishedSwitch">Published</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a class="btn btn-outline-secondary" href="/blog">Cancel</a>
                    </div>
                </form>
            </div>
        </section>

        <%- include('partials/html-end') %>