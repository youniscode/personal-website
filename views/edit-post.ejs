<%- include('partials/html-start', { title: `Edit: ${post.title}` }) %>
    <%- include('partials/header') %>

        <section class="section">
            <div class="container" style="max-width: 860px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h1 class="display-6 fw-bolder mb-0">Edit Post</h1>
                    <a class="btn btn-outline-secondary btn-sm" href="/blog/<%= post.slug %>">View</a>
                </div>

                <form method="post" action="/admin/blog/<%= post.slug %>" class="card shadow-sm p-4">
                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input name="title" type="text" class="form-control" value="<%= post.title %>" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Cover image URL</label>
                        <input name="coverImage" type="url" class="form-control" value="<%= post.coverImage || '' %>">
                        <div class="form-text">Optional. Used for social cards and the list thumbnail.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tags</label>
                        <input name="tags" type="text" class="form-control" value="<%= (post.tags || []).join(', ') %>">
                        <div class="form-text">Comma-separated. We’ll normalize to lowercase.</div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="published" name="published"
                            <%=post.published !==false ? 'checked' : '' %>>
                        <label class="form-check-label" for="published">Published</label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Body (Markdown)</label>
                        <textarea id="postBody" name="body" rows="14" class="form-control"
                            required><%- post.body || '' %></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" type="submit">Save changes</button>
                        <a class="btn btn-outline-secondary" href="/blog/<%= post.slug %>">Cancel</a>

                        <form method="post" action="/admin/blog/<%= post.slug %>/delete"
                            onsubmit="return confirm('Delete this post?');" class="ms-auto">
                            <button class="btn btn-outline-danger" type="submit">Delete</button>
                        </form>
                    </div>
                </form>
            </div>
        </section>

        <!-- SimpleMDE (Markdown editor) -->
        <link rel="stylesheet" href="https://unpkg.com/simplemde@1.11.2/dist/simplemde.min.css">
        <script src="https://unpkg.com/simplemde@1.11.2/dist/simplemde.min.js"></script>
        <script>
            const mde = new SimpleMDE({
                element: document.getElementById('postBody'),
                spellChecker: false,
                status: false,
                renderingConfig: { singleLineBreaks: false },
                forceSync: true
            });
        </script>

        <%- include('partials/html-end') %>